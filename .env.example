# Copy to .env (gitignored) and fill in. Every value has a default; only the HF_* and CONTACT_EMAIL
# lines normally need editing.

# --- Feeds (transport.data.gouv.fr) ---
TRIP_UPDATES_URL=https://proxy.transport.data.gouv.fr/resource/sncf-gtfs-rt-trip-updates
# Optional second Trip Updates URL, asked only when the first gives no usable feed. Empty = none
# (the former sncf-all-gtfs-rt-trip-updates answered HTTP 404 on 2026-11-17).
TRIP_UPDATES_URL_FALLBACK=
ALERTS_URL=https://proxy.transport.data.gouv.fr/resource/sncf-gtfs-rt-service-alerts
STATIC_GTFS_URL=https://eu.ftp.opendatasoft.com/sncf/plandata/Export_OpenData_SNCF_GTFS_NewTripId.zip

# --- Polling ---
POLL_SECONDS=120
# 0 = run forever. Set to 10 for a short local test.
RUN_FOR_MINUTES=0
# One gzipped protobuf snapshot per feed every N minutes (for reprocessing).
RAW_SAMPLE_EVERY_MIN=60

# --- Politeness: sent in the User-Agent so the feed owner can reach you ---
CONTACT_EMAIL=

# --- Disk cap for data/ (oldest already-uploaded files are deleted first) ---
MAX_LOCAL_MB=2048

# --- Hugging Face upload. Leave HF_TOKEN empty = dry-run (files are kept locally). ---
# HF_REPO is the dataset id you created by hand, e.g. your-user/train-correspondances-gtfs-rt
HF_REPO=
HF_TOKEN=
